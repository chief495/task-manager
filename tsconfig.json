{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./web/static/js",
    "rootDir": "./web/frontend"
  },
  "include": [
    "web/frontend/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}